# Python
.venv/
__pycache__/
*.pyc

# Node / web build
web/node_modules/
web/dist/

# Original user-supplied data dump -- not used by the running app (server/main.py
# reads from app/data/ + app/raw_sources/ instead), and far too large for git.
data/

# Generated at build/runtime, not source -- regenerate with
# scripts/build_catalog.py, or on first request (on_demand_cache/):
app/on_demand_cache/

# The synced master parquet (~80 MB, from Google Drive -- see
# scripts/sync_from_drive.py). Never commit; each environment fetches its own copy.
app/data/

# catalog.json and app/raw_sources/ are NOT ignored -- they're small, generated on a
# machine with full `to JD/` access, and committing them is what lets a deploy host
# run without that tree at all. See README.md "Adding new data".
